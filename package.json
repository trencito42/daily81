{
  "name": "daily81",
  "version": "1.0.0",
  "private": true,
  "description": "Minimalist mathematical Sudoku notebook with daily puzzles, streaks, and XP",
  "scripts": {
    "dev": "next dev -p 3007",
    "build": "next build",
    "start": "next start -p 3007 -H 0.0.0.0",
    "lint": "next lint",
