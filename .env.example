# Deployment
NODE_ENV=production
PORT=3007

# MySQL Database
DATABASE_URL="mysql://daily81_user:your_secure_password_here@localhost:3306/daily81"

# Auth Secret (must be at least 32 random characters)
NEXTAUTH_SECRET=your_nextauth_secret_key_at_least_32_characters_long
NEXTAUTH_URL=https://daily81.com

# Daily Puzzle Security
# REQUIRED in production. A high-entropy random string (>= 32 chars).
# Used as HMAC-SHA256 key to derive deterministic puzzle seeds.
# NEVER commit the real value. NEVER expose in logs or API responses.
# Generate with: openssl rand -hex 32
DAILY_SEED_PEPPER=your_daily_seed_pepper_at_least_32_random_chars_here

# Email (SMTP) — required for password reset and welcome email
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=noreply@daily81.com

# Analytics (public — safe to expose in client bundle)
NEXT_PUBLIC_WITCH_PROJECT_ID=wep_327d39f97e1b3dd73e2ceac3e211980dd79911720934254b
